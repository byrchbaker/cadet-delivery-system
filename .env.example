# Copy to .env and fill in what you need. Everything here is optional —
# texting and email can also be set up from Settings → Text & email setup.

# The public address of your site. Used for links inside texts and emails.
APP_URL=https://delivery.example.com

# Port the server listens on.
PORT=8080

# Where the database, uploads and nightly backups live.
# DATA_DIR=/data
# How many nightly backups to keep.
# BACKUP_KEEP=14

# --- Email (SMTP). Gmail: smtp.gmail.com, port 587, use an App Password. ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com

# --- Text messages (Twilio) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+17195550123
# Or, instead of a single number, a Messaging Service:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
